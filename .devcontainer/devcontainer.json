{
  "name": "Wrapper",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/home/vscode/app",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/dhoeric/features/act:1": {},
    "ghcr.io/devcontainers-extra/features/apt-packages:1": {
      "packages": "gcc-aarch64-linux-gnu,g++-aarch64-linux-gnu"
    },
    "ghcr.io/stu-bell/devcontainer-features/claude-code:0": {}
  },
  "postAttachCommand": "/bin/zsh .devcontainer/postAttachCommand.sh",
  "postCreateCommand": "/bin/zsh .devcontainer/postCreateCommand.sh",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "ANDROID_NDK_ROOT": "/opt/android-ndk-r23b"
  },
  "mounts": [
    "source=${env:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached,readonly",
    "source=${env:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${env:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached,readonly",
    "source=${env:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached"
  ],
  "remoteEnv": {
    "ANTHROPIC_BASE_URL": "${localEnv:ANTHROPIC_BASE_URL}",
    "ANTHROPIC_AUTH_TOKEN": "${localEnv:ANTHROPIC_AUTH_TOKEN}",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "UV_LINK_MODE": "copy",
    "WAKATIME_API_KEY": "${localEnv:WAKATIME_API_KEY}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "PKief.material-icon-theme",
        "antfu.file-nesting",
        "eamodio.gitlens",
        "github.vscode-github-actions",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "tamasfe.even-better-toml",
        "twxs.cmake",
        "vsls-contrib.gitdoc"
      ],
      "settings": {
        "debug.internalConsoleOptions": "openOnFirstSessionStart",
        "editor.formatOnPaste": true,
        "editor.formatOnSave": true,
        "files.exclude": {
          "**/.cache": true,
          "**/build": true,
          "**/*.o": true,
          "**/*.obj": true,
          "subhook/build": true
        },
        "files.watcherExclude": {
          "**/.cache/**": true,
          "**/build/**": true,
          "**/subhook/**": true,
          "/opt/android-ndk-r23b/**": true
        },
        "search.exclude": {
          "**/.cache/**": true,
          "**/build/**": true,
          "**/rootfs/system/**": true,
          "**/subhook/**": true
        },
        "C_Cpp.default.compilerPath": "/opt/android-ndk-r23b/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android22-clang++",
        "C_Cpp.default.intelliSenseMode": "linux-clang-arm64",
        "C_Cpp.formatting": "clangFormat",
        "C_Cpp.clang_format_fallbackStyle": "file",
        "[c]": {
          "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
        },
        "[cpp]": {
          "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
        },
        "cmake.buildDirectory": "${workspaceFolder}/build",
        "cmake.configureOnOpen": true
      }
    }
  }
}
