{
  "name": "Wrapper",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/home/vscode/app",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/dhoeric/features/act:1": {},
    "ghcr.io/devcontainers-extra/features/apt-packages:1": {
      "packages": "gcc-aarch64-linux-gnu,g++-aarch64-linux-gnu,ninja-build,jq,clang-format"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false,
      "installDockerBuildx": true,
      "installDockerComposeSwitch": true
    },
    "ghcr.io/shyim/devcontainers-features/bun:0": {},
    "ghcr.io/devcontainers/features/node:1.5.0": {
      "version": "25.9.0"
    },
    "ghcr.io/devcontainers/features/rust:1": {},
    "ghcr.io/stu-bell/devcontainer-features/claude-code:0": {},
    "ghcr.io/thamaji/devcontainer-features/codex-cli:1": {
      "VERSION": "latest"
    }
  },
  // The codex-cli feature's postCreateCommand ends by deleting itself, but it
  // sits in a root-owned directory while lifecycle commands run as vscode - so
  // the `rm` fails, `set -e` aborts it, and the CLI then skips every remaining
  // user command. onCreate runs a phase earlier than any postCreate, so handing
  // the directory over here lets the feature clean itself up.
  "onCreateCommand": "sudo chown \"$(id -un)\" /usr/local/codex-cli 2>/dev/null || true",
  "postAttachCommand": "/bin/zsh .devcontainer/postAttachCommand.sh",
  "postCreateCommand": "/bin/zsh .devcontainer/postCreateCommand.sh",
  "containerEnv": {
    "CLAUDE_CODE_AUTO_MODE_SERVER": "0",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "CODEX_HOME": "/home/vscode/.codex",
    "CODEX_MODEL": "${localEnv:CODEX_MODEL}",
    "ANDROID_NDK_HOME": "/opt/android-ndk-r23b",
    "ANDROID_NDK_ROOT": "/opt/android-ndk-r23b"
  },
  "mounts": [
    "source=${env:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached,readonly",
    "source=${env:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${env:HOME}/.codex,target=/home/vscode/.codex,type=bind,consistency=cached",
    "source=${env:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached,readonly",
    "source=${env:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached"
  ],
  "remoteEnv": {
    "CODEX_HOME": "/home/vscode/app/.codex",
    "CLAUDE_CODE_AUTO_MODE_SERVER": "0",
    "ANTHROPIC_BASE_URL": "${localEnv:ANTHROPIC_BASE_URL}",
    "ANTHROPIC_AUTH_TOKEN": "${localEnv:ANTHROPIC_AUTH_TOKEN}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "OPENAI_BASE_URL": "${localEnv:OPENAI_BASE_URL}",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "UV_LINK_MODE": "copy",
    "WAKATIME_API_KEY": "${localEnv:WAKATIME_API_KEY}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "PKief.material-icon-theme",
        "WakaTime.vscode-wakatime",
        "antfu.file-nesting",
        "eamodio.gitlens",
        "github.vscode-github-actions",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "twxs.cmake",
        "vsls-contrib.gitdoc"
      ]
    }
  }
}
