# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs
# editorconfig.org

root = true

[*]

indent_style = space
indent_size = 2

end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[**/*.{ts,json}]
indent_size = 2
quote_type = single

[*.{c,cpp,cc,cxx,h,hpp,hxx}]
indent_style = space
indent_size = 4
max_line_length = 120

[Makefile]
indent_style = tab

[CMakeLists.txt]
indent_style = space
indent_size = 2
